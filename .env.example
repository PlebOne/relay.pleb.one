# Database
DATABASE_URL="postgresql://username:password@localhost:5432/relay_pleb_one"

# Redis (docker compose). Optional: when set, redis runs with requirepass and
# the app and relay authenticate with it. Leave empty for no auth.
REDIS_PASSWORD=""

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Relay Configuration
RELAY_NAME="relay.pleb.one"
RELAY_DESCRIPTION="A premium Nostr relay with invite-gated access"
RELAY_PUBKEY=""
RELAY_CONTACT="admin@relay.pleb.one"
RELAY_PORT=3001

# Admin Configuration
ADMIN_NPUB="npub13hyx3qsqk3r7ctjqrr49uskut4yqjsxt8uvu4rekr55p08wyhf0qq90nt7"
ADMIN_DM_NSEC="" # optional - enables automated DMs when whitelisting

# Payment Configuration (Lightning Network)
LIGHTNING_NODE_URL="https://your-lnd-node:8080"
LIGHTNING_MACAROON="your-macaroon-here"
MONTHLY_PRICE_SATS=1250
YEARLY_PRICE_SATS=12500
# Rate Limiting
MAX_EVENTS_PER_MINUTE=60
MAX_SUBSCRIPTIONS_PER_CONNECTION=20
MAX_EVENT_SIZE=65536

# Public Configuration
NEXT_PUBLIC_RELAY_URL="ws://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RELAY_NAME="relay.pleb.one"
# Cron Jobs
CRON_SECRET="your-random-secret-for-cron-auth"

# Sentry error monitoring (optional). Leave SENTRY_DSN empty to disable.
# Used for both the server and (via a build arg) the browser bundle.
# Set SENTRY_RELEASE at build time: SENTRY_RELEASE=$(git rev-parse --short HEAD) docker compose build app
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
