# Caddyfile for relay.pleb.one
# Automatic HTTPS with Let's Encrypt

{$RELAY_DOMAIN:relay.pleb.one} {
    # WebSocket for Nostr relay - Must be first to catch all WS connections
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy relay:3001 {
            # WebSocket specific settings
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            
            # Force HTTP/1.1 for WebSocket connections
            transport http {
                versions 1.1
                read_timeout 3600s
                write_timeout 3600s
            }
        }
    }

    # CORS preflight: answer OPTIONS directly (CORS headers come from the header block below)
    @preflight method OPTIONS
    handle @preflight {
        respond 204
    }

    # NIP-11 Relay Information Document (root path with specific Accept header)
    @nip11 {
        path /
        header Accept application/nostr+json
    }
    handle @nip11 {
        reverse_proxy relay:3001
    }

    # NIP-05 verification endpoint
    handle /.well-known/nostr.json* {
        rewrite * /api{uri}
        reverse_proxy app:3000
    }

    # Main application (Next.js)
    handle /api/* {
        reverse_proxy app:3000
    }
    
    handle /* {
        reverse_proxy app:3000
    }
    
    # Health check endpoint
    handle /health {
        reverse_proxy app:3000
    }
    
    # CORS for NIP-11 and other GET requests from browser clients.
    # Deferred so these replace (not duplicate) any CORS headers set upstream.
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Headers "*"
        Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        defer
    }

    # Security headers
    header {
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # Content Security Policy
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: wss: https://*.ingest.us.sentry.io; frame-ancestors 'none';"
        
        # Other security headers
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Remove server info
        -Server
    }
    
    # Enable compression
    encode gzip zstd
    
    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
    
    # Rate limiting for API endpoints (Requires custom Caddy build with rate-limit module)
    # rate_limit {
    #     zone api {
    #         key {remote_host}
    #         events 100
    #         window 1m
    #     }
    #     
    #     zone websocket {
    #         key {remote_host}
    #         events 10
    #         window 1m
    #     }
    # }
}

# NIP-05-only subdomains (users pick one of these or relay.pleb.one in the dashboard)
# Caddy's reverse_proxy passes the client Host header through unchanged and sets
# X-Forwarded-Host to it, so the app sees e.g. id.pleb.one and answers for that domain.
# CORS headers are set by the app.
id.pleb.one, me.pleb.one, nostr.pleb.one, based.pleb.one {
    handle /.well-known/nostr.json* {
        rewrite * /api{uri}
        reverse_proxy app:3000
    }

    # Everything else goes to the main site
    handle {
        redir https://pleb.one{uri}
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/access.log
        format json
    }
}

# Development configuration (if not using custom domain)
localhost:80 {
    reverse_proxy app:3000
    
    handle /ws {
        reverse_proxy relay:3001
    }
}

# Redirect www to non-www
www.{$RELAY_DOMAIN:relay.pleb.one} {
    redir https://{$RELAY_DOMAIN:relay.pleb.one}{uri} permanent
}